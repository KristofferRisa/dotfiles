# Global git config. git reads ~/.config/git/config natively; ~/.gitconfig,
# if present, is read after this file and wins on conflicts.

[user]
	name = Kristoffer Risa
	email = kristofferrisa@gmail.com
	# GPG signing key (rsa4096, `gpg --list-secret-keys --keyid-format long`).
	# Point a machine at another key in config.local (below).
	signingKey = 6CA457F62E35D1DF

# Sign every commit and tag with GPG. GitHub shows them as Verified once the
# public key is added under Settings -> SSH and GPG keys.
[gpg]
	format = openpgp
[gpg "ssh"]
	# Kept after the switch to GPG: commits signed with SSH before it still
	# need these public keys for `git log --show-signature` / `git verify-commit`.
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgSign = true
[tag]
	gpgSign = true

[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[core]
	editor = nvim
[fetch]
	prune = true
[rerere]
	enabled = true

# Machine-specific overrides (work email, different signing key). Gitignored;
# a missing file is skipped.
[include]
	path = ~/.config/git/config.local
